<article class="card">
  <a class="card-media" href="{{ product.url }}">
    {% if product.featured_image %}
      {{ product.featured_image | image_url: width: 700 | image_tag: loading: 'lazy' }}
    {% else %}
      <span>Product Image<br>Placeholder</span>
    {% endif %}
  </a>
  <div class="card-body">
    <span class="card-cat">{{ product.type | default: 'Category Placeholder' }}</span>
    <h3><a href="{{ product.url }}">{{ product.title }}</a></h3>
    <p class="price">{{ product.price | money }}{% if product.compare_at_price > product.price %} <small>{{ product.compare_at_price | money }}</small>{% endif %}</p>
    <a class="btn btn-dark btn-sm" href="{{ product.url }}">View Product</a>
  </div>
</article>
