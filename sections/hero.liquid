<section class="bs-hero">
  <div class="bs-hero-media"{% if section.settings.image %} style="background-image:url('{{ section.settings.image | image_url: width: 1800 }}')"{% endif %}></div>
  <div class="bs-hero-inner">
    {% if section.settings.eyebrow != blank %}<div class="bs-eyebrow">{{ section.settings.eyebrow }}</div>{% endif %}
    <h1>{{ section.settings.headline }}</h1>
    {% if section.settings.subtext != blank %}<p>{{ section.settings.subtext }}</p>{% endif %}
    {% if section.settings.button_label != blank %}
      <a class="bs-btn" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
    {% endif %}
  </div>
</section>
{% schema %}
{"name": "Hero", "settings": [
  {"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "B.I.G. Steppas LLC"},
  {"type": "text", "id": "headline", "label": "Headline", "default": "Everyday finds. Bigger possibilities."},
  {"type": "textarea", "id": "subtext", "label": "Subheadline", "default": "Kitchen tools with purpose. The choppers that do the prep work for you \u2014 built for real kitchens, priced for real people."},
  {"type": "image_picker", "id": "image", "label": "Hero image (optional \u2014 a built-in photo is used until you pick one)"},
  {"type": "text", "id": "button_label", "label": "Button label", "default": "Explore the Collection"},
  {"type": "url", "id": "button_link", "label": "Button link"}
], "presets": [{"name": "Hero"}]}
{% endschema %}
