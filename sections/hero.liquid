<section class="hero">
  <div class="hero-copy">
    <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    <h1>{{ section.settings.headline }}</h1>
    <p class="placeholder-text">{{ section.settings.subtext }}</p>
    <div class="hero-ctas">
      {% if section.settings.button_label != blank %}
        <a class="btn btn-dark" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
      {% endif %}
      {% if section.settings.button2_label != blank %}
        <a class="btn btn-ghost" href="{{ section.settings.button2_link | default: '#' }}">{{ section.settings.button2_label }}</a>
      {% endif %}
    </div>
  </div>
  <div class="hero-media">
    {% if section.settings.image %}
      {{ section.settings.image | image_url: width: 1200 | image_tag }}
    {% else %}
      <span>Hero Image<br>Placeholder</span>
    {% endif %}
  </div>
</section>
{% schema %}
{"name": "Hero", "settings": [
  {"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Hero Eyebrow Placeholder"},
  {"type": "text", "id": "headline", "label": "Headline", "default": "Headline Placeholder for a Premium Kitchen Store"},
  {"type": "textarea", "id": "subtext", "label": "Subheadline", "default": "Subheadline placeholder. Add your own value statement here."},
  {"type": "image_picker", "id": "image", "label": "Hero image"},
  {"type": "text", "id": "button_label", "label": "Button label", "default": "Shop the Collection"},
  {"type": "url", "id": "button_link", "label": "Button link"},
  {"type": "text", "id": "button2_label", "label": "Second button label", "default": "Our Story"},
  {"type": "url", "id": "button2_link", "label": "Second button link"}
], "presets": [{"name": "Hero"}]}
{% endschema %}
