<section class="bs-wrap bs-section">
  <div class="bs-banner">
    {% if section.settings.pill != blank %}<div class="bs-pill">{{ section.settings.pill }}</div>{% endif %}
    {% if section.settings.kick != blank %}<div class="bs-kick">{{ section.settings.kick }}</div>{% endif %}
    <h2>{{ section.settings.title }}</h2>
    {% if section.settings.text != blank %}<p>{{ section.settings.text }}{% if section.settings.code != blank %} <span class="bs-code">{{ section.settings.code }}</span>{% endif %}</p>{% endif %}
    {% if section.settings.button_label != blank %}<a class="bs-btn" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>{% endif %}
  </div>
</section>
{% schema %}
{"name": "Sale banner", "settings": [
  {"type": "text", "id": "pill", "label": "Pill (optional)"},
  {"type": "text", "id": "kick", "label": "Kicker (optional)"},
  {"type": "text", "id": "title", "label": "Title", "default": "CHRISTMAS SALE"},
  {"type": "textarea", "id": "text", "label": "Text"},
  {"type": "text", "id": "code", "label": "Discount code chip (optional)"},
  {"type": "text", "id": "button_label", "label": "Button label"},
  {"type": "url", "id": "button_link", "label": "Button link"}
], "presets": [{"name": "Sale banner"}]}
{% endschema %}
