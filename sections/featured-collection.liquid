<section class="bs-wrap bs-section">
  <div class="bs-sec-head"><h2>{{ section.settings.heading }}</h2>{% if section.settings.collection and section.settings.view_all_label != blank %}<a href="{{ section.settings.collection.url }}">{{ section.settings.view_all_label }} &rarr;</a>{% endif %}</div>
  <div class="bs-grid">
    {% if section.settings.collection %}
      {% for product in section.settings.collection.products limit: section.settings.product_limit %}
        {% render 'product-card', product: product %}
      {% endfor %}
    {% else %}
      <p style="color:#b8b0a0">Pick a collection in the theme editor and this section fills with real products.</p>
    {% endif %}
  </div>
</section>
{% schema %}
{"name": "Top picks (featured collection)", "settings": [
  {"type": "text", "id": "heading", "label": "Heading", "default": "Top Picks for You"},
  {"type": "text", "id": "view_all_label", "label": "View-all label", "default": "See All Deals"},
  {"type": "collection", "id": "collection", "label": "Collection"},
  {"type": "range", "id": "product_limit", "label": "Products to show", "min": 3, "max": 9, "step": 1, "default": 4}
], "presets": [{"name": "Top picks"}]}
{% endschema %}
