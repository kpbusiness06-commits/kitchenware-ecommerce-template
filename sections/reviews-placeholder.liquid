<section class="section reviews">
  <div class="section-head"><h2>{{ section.settings.heading }}</h2></div>
  <div class="grid grid-3">
    {% for i in (1..3) %}
      <blockquote class="review">
        <div class="stars">***** <small>Rating Placeholder</small></div>
        <p class="placeholder-text">&ldquo;Review text placeholder. Add a real customer review here.&rdquo;</p>
        <cite>Reviewer Name Placeholder</cite>
      </blockquote>
    {% endfor %}
  </div>
</section>
{% schema %}
{"name": "Reviews placeholder", "settings": [
  {"type": "text", "id": "heading", "label": "Heading", "default": "Customer Reviews"}
], "presets": [{"name": "Reviews placeholder"}]}
{% endschema %}
