<section class="bs-pagehead">
  <h1>{{ collection.title }}</h1>
  {% if collection.description != blank %}<p>{{ collection.description }}</p>{% endif %}
</section>
<div class="bs-toolbar">
  <span>{{ collection.products_count }} {% if collection.products_count == 1 %}product{% else %}products{% endif %}</span>
  <form method="get">
    <label>Sort
      <select name="sort_by">
        {% for option in collection.sort_options %}
          <option value="{{ option.value }}"{% if option.value == collection.sort_by %} selected{% endif %}>{{ option.name }}</option>
        {% endfor %}
      </select>
    </label>
    <button class="bs-apply" type="submit">Apply</button>
  </form>
</div>
{% paginate collection.products by 24 %}
  <div class="bs-collgrid">
    {% for product in collection.products %}
      {% render 'product-card', product: product %}
    {% else %}
      <div class="bs-empty" style="grid-column:1/-1">
        <p>Nothing here yet — this collection is on its way.</p>
        <a class="bs-btn" href="{{ routes.all_products_collection_url }}">Shop All Products</a>
      </div>
    {% endfor %}
  </div>
  {% if paginate.pages > 1 %}
    <div class="bs-pager">{{ paginate | default_pagination }}</div>
  {% endif %}
{% endpaginate %}
{% schema %}
{"name": "Collection", "settings": []}
{% endschema %}
