<header class="bs-header">
  <div class="bs-announce">{{ section.settings.announcement }}</div>
  <div class="bs-bar">
    <button class="bs-burger" type="button" aria-label="Open menu" data-nav-toggle><span></span><span></span></button>
    <button class="bs-icon bs-search-mob" type="button" aria-label="Search" data-search-open><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M20.5 20.5 16.6 16.6"/></svg></button>
    <a class="bs-brand" href="{{ routes.root_url }}">{{ shop.name }}</a>
    <nav class="bs-nav" data-nav>
      {% for link in linklists[section.settings.menu].links %}
        <a href="{{ link.url }}"{% if link.active %} class="bs-here"{% endif %}>{{ link.title }}</a>
      {% else %}
        <a href="{{ routes.root_url }}">Home</a>
        <a href="{{ routes.all_products_collection_url }}">Products</a>
      {% endfor %}
    </nav>
    <div class="bs-icons">
      <button class="bs-icon bs-search-desk" type="button" aria-label="Search" data-search-open><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M20.5 20.5 16.6 16.6"/></svg></button>
      <a class="bs-icon" href="{{ routes.account_url }}" aria-label="Account"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="8" r="3.6"/><path d="M4.6 20c1.3-3.6 4.1-5.3 7.4-5.3s6.1 1.7 7.4 5.3"/></svg></a>
      <a class="bs-icon" href="{{ routes.cart_url }}" aria-label="Cart"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 8h14l-1.1 12.1a1.5 1.5 0 0 1-1.5 1.4H7.6a1.5 1.5 0 0 1-1.5-1.4L5 8Z"/><path d="M8.5 10.5V6.8a3.5 3.5 0 0 1 7 0v3.7"/></svg>{% if cart.item_count > 0 %}<span class="bs-count">{{ cart.item_count }}</span>{% endif %}</a>
    </div>
  </div>
  <div class="bs-searchbar" data-search-bar hidden>
    <form action="{{ routes.search_url }}" method="get" role="search">
      <input type="search" name="q" placeholder="Search the store" aria-label="Search">
      <button type="submit">Search</button>
      <button type="button" data-search-close aria-label="Close search" style="background:transparent;color:#f7f4ed;font-size:1.2rem;padding:.4rem .7rem">&times;</button>
    </form>
  </div>
</header>
{% schema %}
{"name": "Header", "settings": [
  {"type": "text", "id": "announcement", "label": "Announcement", "default": "Welcome to our store"},
  {"type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu"}
]}
{% endschema %}
