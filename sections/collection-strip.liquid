<section class="bs-wrap bs-section">
  <div class="bs-sec-head"><h2>{{ section.settings.heading }}</h2><a href="/collections">All Collections &rarr;</a></div>
  <div class="bs-tiles">
    {% for c in collections %}
      {% unless c.handle == 'all' or c.handle == 'frontpage' %}
        {% if c.handle == collection.handle %}
          <div class="bs-tile bs-current" style="min-height:120px">
            {% if c.image %}
              <img src="{{ c.image | image_url: width: 700 }}" alt="{{ c.title | escape }}" loading="lazy">
            {% elsif c.products.first.featured_image %}
              <img src="{{ c.products.first.featured_image | image_url: width: 700 }}" alt="{{ c.title | escape }}" loading="lazy">
            {% endif %}
            <span class="bs-heretag">You are here</span>
            <span class="bs-tile-lbl">{{ c.title }}</span>
          </div>
        {% else %}
          <a class="bs-tile" href="{{ c.url }}" style="min-height:120px">
            {% if c.image %}
              <img src="{{ c.image | image_url: width: 700 }}" alt="{{ c.title | escape }}" loading="lazy">
            {% elsif c.products.first.featured_image %}
              <img src="{{ c.products.first.featured_image | image_url: width: 700 }}" alt="{{ c.title | escape }}" loading="lazy">
            {% endif %}
            <span class="bs-tile-lbl">{{ c.title }}</span>
          </a>
        {% endif %}
      {% endunless %}
    {% endfor %}
  </div>
</section>
{% schema %}
{"name": "Collection strip", "settings": [
  {"type": "text", "id": "heading", "label": "Heading", "default": "More Collections"}
], "presets": [{"name": "Collection strip"}]}
{% endschema %}
