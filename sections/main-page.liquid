<section class="page-head"><h1>{{ page.title }}</h1></section>
<section class="prose">
  {% if page.content != blank %}
    {{ page.content }}
  {% else %}
    <p class="placeholder-text">Page content placeholder. Add this page's real content in the Shopify admin page editor.</p>
  {% endif %}
</section>
{% schema %}
{"name": "Page", "settings": []}
{% endschema %}
