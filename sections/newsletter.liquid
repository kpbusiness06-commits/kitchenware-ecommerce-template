<section class="newsletter">
  <h2>{{ section.settings.heading }}</h2>
  <p class="placeholder-text">{{ section.settings.text }}</p>
  {% form 'customer', class: 'newsletter-form' %}
    <input type="hidden" name="contact[tags]" value="newsletter">
    <input type="email" name="contact[email]" required placeholder="Email address" aria-label="Email address">
    <button class="btn btn-dark" type="submit">Sign Up</button>
    {% if form.posted_successfully? %}<p class="form-note">Thank you for subscribing.</p>{% endif %}
    {% if form.errors %}<p class="form-note">{{ form.errors.translated_fields.email }} {{ form.errors.messages.email }}</p>{% endif %}
  {% endform %}
</section>
{% schema %}
{"name": "Newsletter", "settings": [
  {"type": "text", "id": "heading", "label": "Heading", "default": "Newsletter Signup"},
  {"type": "textarea", "id": "text", "label": "Text", "default": "Invite placeholder — tell visitors what they get for joining your list."}
], "presets": [{"name": "Newsletter"}]}
{% endschema %}
