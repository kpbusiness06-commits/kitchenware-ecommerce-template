{% style %}
.bs-fbless{color:#d9bc7a;letter-spacing:.3em;font-size:.72rem;text-transform:uppercase;display:block;margin-bottom:.3rem}
{% endstyle %}
<footer class="bs-footer">
  <div class="bs-fgrid">
    <div>
      <div class="bs-fname">{{ shop.name }}</div>
      <p class="bs-fstate">Kitchen tools with purpose.<br>Bless. Inspire. Grow.</p>
    </div>
    <div>
      <h4>Shop</h4>
      <a href="/collections/appliances">Appliances</a>
      <a href="/collections/bakeware">Bakeware</a>
      <a href="/collections/best-selling">B.I.G.'s Best Sellers</a>
      <a href="/collections/cleaning-storage">Cleaning &amp; Storage</a>
      <a href="/collections/cookware">Cookware</a>
      <a href="/collections/knives-boards">Knives &amp; Boards</a>
      <a href="/collections/utensils-gadgets">Utensils &amp; Gadgets</a>
      <a href="/pages/bulk-orders">Business &amp; Bulk Orders</a>
    </div>
    <div>
      <h4>Customer Care</h4>
      <a href="/policies/shipping-policy">Shipping Policy</a>
      <a href="/policies/refund-policy">Refund Policy</a>
      <a href="/pages/about-us">About Us</a>
      <a href="/pages/help">Contact Us</a>
      <a href="/pages/help">FAQ</a>
    </div>
    <div>
      <h4>Legal</h4>
      <a href="/policies/privacy-policy">Privacy Policy</a>
      <a href="/policies/terms-of-service">Terms Of Service</a>
      <a href="/policies/legal-notice">Legal Notice</a>
    </div>
  </div>
  <div class="bs-fbottom">
    <span><span class="bs-fbless">Bless &middot; Inspire &middot; Grow</span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</span>
    <span class="bs-pay">
      {% for type in shop.enabled_payment_types %}
        <img src="https://cdn.shopify.com/shopifycloud/shopify/assets/payment-icons/{{ type | payment_type_svg_filename }}" alt="{{ type }}" loading="lazy" onerror="this.remove()">
      {% endfor %}
    </span>
  </div>
</footer>
{% schema %}
{"name": "Footer", "settings": []}
{% endschema %}
